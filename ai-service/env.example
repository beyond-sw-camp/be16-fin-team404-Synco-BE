# Kafka 설정
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUEST_TOPIC=recording-completed
KAFKA_RESPONSE_TOPIC=transcript-completed

# ASR 모델 설정 (모델 성능 비교)

# ASR_MODEL 옵션:
# - tiny: 가장 빠름 (1GB), 정확도 낮음 (~30초 영상 10초 처리)
# - base: 빠름 (1GB), 정확도 보통
# - small: 보통 (2GB), 정확도 좋음 (~30초 영상 30초 처리)
# - medium: 느림 (5GB), 정확도 매우 좋음 (~30초 영상 1분 처리) ⭐ 권장
# - large: 매우 느림 (10GB), 정확도 최고 (거의 사용 안함)

ASR_MODEL=medium
ASR_COMPUTE_TYPE=int8
ASR_DEVICE=cpu

# 로깅 레벨
LOG_LEVEL=INFO

# AWS 설정 (S3 직접 접근 시 필요)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-northeast-2
